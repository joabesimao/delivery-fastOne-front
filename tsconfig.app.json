{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/enums",
    "src/components/charts",
    "src/components/menu/menuBar.tsx",
    "src/components/menu/index.tsx",
    "src/components/menu/components",
    "src/components/reactTable",
    "src/components/exportTable",
    "src/components/indicatorPanel",
    "src/components/tabs/genericFunctionTabs.tsx",
    "src/components/LazyChart.tsx",
    "src/components/VirtualizedChart.tsx",
    "src/components/NotificationPopup.tsx",
    "src/components/PermissionsSyncProvider.tsx",
    "src/components/UserSearchSelect.tsx",
    "src/components/InfiniteScrollSelect.tsx",
    "src/components/DatePickerComponent.tsx",
    "src/components/DateRangePickerComponent.tsx",
    "src/components/HoursRangeComponent.tsx",
    "src/components/DateTimePickerComponent.tsx",
    "src/components/FilterWithDateRange.tsx",
    "src/components/modalConfirm",
    "src/components/types",
    "src/hooks/class"
  ]
}
